<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Voice DAW – Round 1</title>
<style>
:root{--bg:#0F1115;--panel:#171A21;--line:#262B35;--txt:#E8EAF0;--mut:#8A93A6;--acc:#6A46FF;--acc2:#9B87FF;--mint:#2EE6A6;--org:#FF8A4C;--sky:#4CC3FF}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:720px;margin:0 auto;padding:24px 16px 48px}
h1{font-size:22px;margin:0 0 4px}
.sub{color:var(--mut);margin:0 0 20px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:16px}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--acc2);outline-offset:2px}
.tabs{display:flex;gap:8px}
.tab{flex:1;padding:12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);font-weight:600}
.tab[aria-pressed=true]{background:var(--acc);border-color:var(--acc);color:#fff}
.go{width:100%;padding:14px;border-radius:12px;border:0;background:var(--mint);color:#0B1210;font-weight:700;font-size:16px}
.go.on{background:#FF6B7A;color:#0B0D12}
.warn{color:var(--org);font-size:13px;margin:8px 0 4px}
.read{text-align:center;padding:16px 0}
.big{font-size:56px;font-weight:700;line-height:1.1}
.mut{color:var(--mut);font-size:13px}
.meter{height:8px;border-radius:4px;background:var(--line);overflow:hidden}
.meter i{display:block;height:100%;width:0;background:var(--mint)}
.pads{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.pad{border:1px solid var(--line);border-radius:12px;padding:26px 0;text-align:center;font-weight:700;background:var(--bg)}
label{display:block;margin:14px 0 4px;color:var(--mut);font-size:13px}
select,input[type=range]{width:100%}
select{padding:10px;border-radius:10px;background:var(--bg);color:var(--txt);border:1px solid var(--line);font:inherit}
.hide{display:none}
</style>
</head>
<body>
<main>
  <h1>Voice DAW – Round 1</h1>
  <p class="sub">Make sounds with your mouth and hear them as instruments.</p>

  <div class="panel">
    <div class="tabs" role="group" aria-label="Mode">
      <button class="tab" id="tHum" aria-pressed="true">Hum to instrument</button>
      <button class="tab" id="tBeat" aria-pressed="false">Beatbox to drums</button>
    </div>
  </div>

  <button class="go" id="go">Start microphone</button>
  <p class="warn">Use headphones. Speakers will feed back into the mic.</p>
  <p class="mut" id="msg" role="status"></p>

  <section class="panel" id="humBox">
    <div class="read">
      <div class="big" id="note">–</div>
      <div class="mut" id="hz">Hum a steady note</div>
    </div>
    <label for="inst">Instrument</label>
    <select id="inst">
      <option value="bass">Bass</option>
      <option value="sub">808 sub</option>
      <option value="lead">Lead synth</option>
      <option value="pad">Pad</option>
    </select>
  </section>

  <section class="panel hide" id="beatBox">
    <div class="pads">
      <div class="pad" id="p-kick">Kick</div>
      <div class="pad" id="p-snare">Snare</div>
      <div class="pad" id="p-hat">Hi-hat</div>
    </div>
    <p class="mut" id="stats" style="text-align:center">Last hit: low –, high –</p>
    <label for="kSplit">Kick sensitivity (right = more kicks)</label>
    <input type="range" id="kSplit" min="0" max="100" value="55">
    <label for="hSplit">Hi-hat sensitivity (right = more hi-hats)</label>
    <input type="range" id="hSplit" min="0" max="100" value="55">
  </section>

  <section class="panel">
    <label for="gate" style="margin-top:0">Mic sensitivity (right picks up quieter sounds)</label>
    <input type="range" id="gate" min="1" max="100" value="50">
    <label for="vol">Volume</label>
    <input type="range" id="vol" min="0" max="100" value="70">
    <label>Mic level</label>
    <div class="meter"><i id="lvl"></i></div>
  </section>
</main>

<script>
const $ = id => document.getElementById(id);
const NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];

// Instruments for hum mode. oct = octave shift, cut = filter cutoff, det = detune of 2nd oscillator.
const INST = {
  bass: {t1:'sawtooth', t2:'square',   det:6,  cut:700,  atk:0.01, rel:0.12, oct:-1},
  sub:  {t1:'sine',     t2:'sine',     det:0,  cut:400,  atk:0.01, rel:0.20, oct:-1},
  lead: {t1:'sawtooth', t2:'sawtooth', det:12, cut:3500, atk:0.01, rel:0.10, oct:0},
  pad:  {t1:'triangle', t2:'sawtooth', det:8,  cut:1200, atk:0.15, rel:0.50, oct:0}
};

let ctx, stream, analyser, master, voice, noiseBuf;
let running = false, mode = 'hum';
let tbuf, fbuf;
let prevRms = 0, lastHit = 0, pending = false;
let candNote = -1, candCount = 0, curNote = -1, silent = 0;
const S = {gate: 0.022, kThr: 0.45, hThr: 0.35};

/* ---------- Setup ---------- */
async function start() {
  try {
    ctx = new (window.AudioContext || window.webkitAudioContext)({latencyHint: 'interactive'});
    stream = await navigator.mediaDevices.getUserMedia({
      audio: {echoCancellation: false, noiseSuppression: false, autoGainControl: false}
    });
  } catch (e) {
    $('msg').textContent = 'Could not open the microphone: ' + e.message +
      ' (the page must be on https or localhost, and mic access must be allowed).';
    return;
  }
  const src = ctx.createMediaStreamSource(stream);
  analyser = ctx.createAnalyser();
  analyser.fftSize = 2048;
  analyser.smoothingTimeConstant = 0;
  src.connect(analyser);               // mic goes to the analyser only, never to the speakers
  tbuf = new Float32Array(analyser.fftSize);
  fbuf = new Float32Array(analyser.frequencyBinCount);

  master = ctx.createGain();
  master.gain.value = $('vol').value / 100;
  master.connect(ctx.destination);

  noiseBuf = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
  const d = noiseBuf.getChannelData(0);
  for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;

  buildVoice();
  running = true;
  $('go').textContent = 'Stop microphone';
  $('go').classList.add('on');
  $('msg').textContent = '';
  requestAnimationFrame(loop);
}

function stop() {
  running = false;
  stream.getTracks().forEach(t => t.stop());
  ctx.close();
  $('go').textContent = 'Start microphone';
  $('go').classList.remove('on');
  $('lvl').style.width = '0';
}

/* ---------- Synth voice for humming ---------- */
function buildVoice() {
  const o1 = ctx.createOscillator(), o2 = ctx.createOscillator();
  const f = ctx.createBiquadFilter(), g = ctx.createGain();
  f.type = 'lowpass';
  g.gain.value = 0;
  o1.connect(f); o2.connect(f); f.connect(g); g.connect(master);
  o1.start(); o2.start();
  voice = {o1, o2, f, g, inst: INST.bass};
  setInst($('inst').value);
}
function setInst(k) {
  if (!voice) return;
  const i = INST[k];
  voice.o1.type = i.t1;
  voice.o2.type = i.t2;
  voice.o2.detune.value = i.det;
  voice.f.frequency.value = i.cut;
  voice.inst = i;
}
function sing(freq) {
  const i = voice.inst, f = freq * Math.pow(2, i.oct), t = ctx.currentTime;
  voice.o1.frequency.setTargetAtTime(f, t, 0.015);
  voice.o2.frequency.setTargetAtTime(f, t, 0.015);
  voice.g.gain.setTargetAtTime(0.5, t, i.atk);
}
function hush() {
  if (!voice) return;
  voice.g.gain.setTargetAtTime(0, ctx.currentTime, voice.inst.rel / 3);
  curNote = -1; candNote = -1; candCount = 0;
}

/* ---------- Pitch detection (autocorrelation) ---------- */
function pitch(b, sr) {
  const N = 1024, minL = Math.floor(sr / 900), maxL = Math.floor(sr / 70);
  let e0 = 0;
  for (let i = 0; i < N; i++) e0 += b[i] * b[i];
  const c = new Float32Array(maxL + 2);
  let best = 0, bl = 0;
  for (let l = minL; l <= maxL; l++) {
    let s = 0, e1 = 0;
    for (let i = 0; i < N; i++) { s += b[i] * b[i + l]; e1 += b[i + l] * b[i + l]; }
    c[l] = s / Math.sqrt(e0 * e1 + 1e-9);
    if (c[l] > best) { best = c[l]; bl = l; }
  }
  if (best < 0.8) return 0;                       // not a clear pitch
  for (let l = minL + 1; l < bl; l++) {           // prefer the shortest strong peak (avoids octave-down errors)
    if (c[l] > 0.9 * best && c[l] >= c[l - 1] && c[l] >= c[l + 1]) { bl = l; break; }
  }
  const a = c[bl - 1], m = c[bl], d = c[bl + 1];
  const den = 2 * (a - 2 * m + d);
  const shift = den ? (a - d) / den : 0;
  return sr / (bl + (isFinite(shift) ? shift : 0));
}

function hum(rms) {
  const f = rms > S.gate ? pitch(tbuf, ctx.sampleRate) : 0;
  if (!f) {
    if (++silent > 3 && curNote >= 0) { hush(); show('–', 'Hum a steady note'); }
    return;
  }
  silent = 0;
  const m = Math.round(69 + 12 * Math.log2(f / 440));
  if (m === candNote) candCount++; else { candNote = m; candCount = 1; }
  if (candCount >= 3 && m !== curNote) {            // a note must hold for 3 frames before it plays
    curNote = m;
    sing(440 * Math.pow(2, (m - 69) / 12));         // snapped to the nearest semitone
    show(NAMES[((m % 12) + 12) % 12] + (Math.floor(m / 12) - 1), Math.round(f) + ' Hz');
  }
}
function show(n, h) { $('note').textContent = n; $('hz').textContent = h; }

/* ---------- Beatbox detection ---------- */
function beat(rms, now) {
  if (pending) { pending = false; classify(); }       // classify one frame after the onset, when the sound has developed
  else if (rms > S.gate && rms > prevRms * 1.6 && now - lastHit > 100) { pending = true; lastHit = now; }
  prevRms = Math.max(rms, prevRms * 0.85);
}
function classify() {
  analyser.getFloatFrequencyData(fbuf);
  const bw = ctx.sampleRate / analyser.fftSize;
  let lo = 0, mi = 0, hi = 0;
  for (let i = 1; i < fbuf.length; i++) {
    const f = i * bw, p = Math.pow(10, fbuf[i] / 10);
    if (f < 250) lo += p; else if (f < 3000) mi += p; else hi += p;
  }
  const t = lo + mi + hi + 1e-12, L = lo / t, H = hi / t;
  const type = L > S.kThr ? 'kick' : (H > S.hThr ? 'hat' : 'snare');
  $('stats').textContent = 'Last hit: low ' + Math.round(L * 100) + '%, high ' + Math.round(H * 100) + '%';
  drum(type);
  flash(type);
}

/* ---------- Drum sounds ---------- */
function drum(type) {
  const t = ctx.currentTime;
  if (type === 'kick') {
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.frequency.setValueAtTime(160, t);
    o.frequency.exponentialRampToValueAtTime(45, t + 0.12);
    g.gain.setValueAtTime(1, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
    o.connect(g); g.connect(master);
    o.start(t); o.stop(t + 0.45);
    return;
  }
  const hat = type === 'hat', dur = hat ? 0.06 : 0.2;
  const n = ctx.createBufferSource(), f = ctx.createBiquadFilter(), g = ctx.createGain();
  n.buffer = noiseBuf;
  f.type = 'highpass'; f.frequency.value = hat ? 7000 : 1500;
  g.gain.setValueAtTime(hat ? 0.5 : 0.8, t);
  g.gain.exponentialRampToValueAtTime(0.001, t + dur);
  n.connect(f); f.connect(g); g.connect(master);
  n.start(t); n.stop(t + dur + 0.02);
  if (!hat) {                                          // add a tone body to the snare
    const o = ctx.createOscillator(), og = ctx.createGain();
    o.type = 'triangle'; o.frequency.value = 190;
    og.gain.setValueAtTime(0.5, t);
    og.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
    o.connect(og); og.connect(master);
    o.start(t); o.stop(t + 0.15);
  }
}
function flash(type) {
  const el = $('p-' + type), col = {kick: '#FF8A4C', snare: '#4CC3FF', hat: '#2EE6A6'}[type];
  el.style.background = col; el.style.color = '#0B0D12';
  setTimeout(() => { el.style.background = ''; el.style.color = ''; }, 120);
}

/* ---------- Main loop ---------- */
function loop(now) {
  if (!running) return;
  analyser.getFloatTimeDomainData(tbuf);
  let s = 0;
  for (let i = 1536; i < 2048; i++) s += tbuf[i] * tbuf[i];
  const rms = Math.sqrt(s / 512);                      // loudness of the most recent ~11 ms
  $('lvl').style.width = Math.min(100, rms * 400) + '%';
  if (mode === 'hum') hum(rms); else beat(rms, now);
  requestAnimationFrame(loop);
}

/* ---------- Controls ---------- */
function setMode(m) {
  mode = m;
  $('tHum').setAttribute('aria-pressed', m === 'hum');
  $('tBeat').setAttribute('aria-pressed', m === 'beat');
  $('humBox').classList.toggle('hide', m !== 'hum');
  $('beatBox').classList.toggle('hide', m !== 'beat');
  if (running) hush();
}
$('go').onclick = () => running ? stop() : start();
$('tHum').onclick = () => setMode('hum');
$('tBeat').onclick = () => setMode('beat');
$('inst').onchange = e => setInst(e.target.value);
$('vol').oninput = e => { if (master) master.gain.value = e.target.value / 100; };
$('gate').oninput = e => { S.gate = 0.002 + 0.08 * Math.pow(1 - e.target.value / 100, 2); };
$('kSplit').oninput = e => { S.kThr = 0.8 - 0.6 * e.target.value / 100; };
$('hSplit').oninput = e => { S.hThr = 0.7 - 0.6 * e.target.value / 100; };
</script>
</body>
</html>
